tag:
  - svbench_v2
  - scandisent_sv_multi_svbv2
dataset_path: json
dataset_kwargs:
  data_files:
    train: data/scandisent_sv_mini/train.jsonl
    validation: data/scandisent_sv_mini/val.jsonl
    test: data/scandisent_sv_mini/test.jsonl
output_type: multiple_choice
training_split: train
validation_split: validation
test_split: test
fewshot_split: train
process_docs: !function scandisent_sv_utils.process_docs
doc_to_target: "{{ gold }}"
doc_to_choice: "choices"
should_decontaminate: true
doc_to_decontamination_query: "{{ query }}"
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
  - metric: acc_norm
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
